# Copy to .env.local and fill in. Never commit .env.local.

# AI that reads and sorts your emails: a local model with Ollama (free, private).
#   brew install ollama && brew services start ollama && ollama pull qwen3.5:9b
# OLLAMA_MODEL=qwen3.5:9b            # smaller/faster: qwen3.5:4b
# OLLAMA_HOST=http://127.0.0.1:11434

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
# AI_CONCURRENCY=1                   # emails classified in parallel
# APP_URL=http://localhost:3000
